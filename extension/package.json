{
  "name": "vscode-swift-userscripts",
  "displayName": "Swift Userscripts",
  "description": "Run VS Code extension features written in Swift via a JSON-RPC host bridge.",
  "version": "0.0.1",
  "publisher": "communitypoke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CommunityPokeOrg/vscode-swift-userscripts.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "swiftUserscripts.reload",
        "title": "Swift Userscripts: Reload Scripts"
      },
      {
        "command": "swiftUserscripts.showLog",
        "title": "Swift Userscripts: Show Log"
      },
      {
        "command": "swiftUserscripts.installVswift",
        "title": "Swift Userscripts: Install .vswift Bundle"
      }
    ],
    "configuration": {
      "title": "Swift Userscripts",
      "properties": {
        "swiftUserscripts.scriptGlob": {
          "type": "string",
          "default": "**/userscript.json",
          "description": "Glob used to discover userscript manifests in the workspace."
        },
        "swiftUserscripts.bundleGlob": {
          "type": "string",
          "default": "**/*.vswift",
          "description": "Glob used to discover .vswift bundle archives in the workspace."
        },
        "swiftUserscripts.buildConfiguration": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ],
          "default": "debug",
          "description": "SwiftPM build configuration used when compiling userscripts."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
